digraph G {
    rankdir=LR;
    node [shape=none, margin=0];
    edge [color="#64748b", arrowsize=0.8, fontname="Helvetica", fontsize=12];

    History [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#64748b" BGCOLOR="#f8fafc" STYLE="ROUNDED">
            <TR><TD><B>历史低复杂度积累</B></TD></TR>
            <TR><TD>T-3: Cost = 100 (静止)</TD></TR>
            <TR><TD>T-2: Cost = 100 (静止)</TD></TR>
            <TR><TD>T-1: Cost = 100 (静止)</TD></TR>
        </TABLE>
    >];

    T0 [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#ef4444" BGCOLOR="#fef2f2" STYLE="ROUNDED">
            <TR><TD><FONT COLOR="#b91c1c"><B>当前瞬间爆炸帧 (T0)</B></FONT></TD></TR>
            <TR><TD>Cost = <B>1000</B> (暴涨 10 倍)</TD></TR>
        </TABLE>
    >];

    EMA [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#0ea5e9" BGCOLOR="#f0f9ff" STYLE="ROUNDED">
            <TR><TD><FONT COLOR="#0284c7"><B>Step 1: EMA 低通滤波 (拖影平滑)</B></FONT></TD></TR>
            <TR><TD>blurredCplx = (历史积淀 + 1000) / Count</TD></TR>
            <TR><TD><FONT COLOR="#0288d1"><B>实际算出约 500</B> (被历史稀释)</FONT></TD></TR>
        </TABLE>
    >];

    qCompress [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#8b5cf6" BGCOLOR="#f5f3ff" STYLE="ROUNDED">
            <TR><TD><FONT COLOR="#6d28d9"><B>Step 2: qCompress 非线性空间折叠</B></FONT></TD></TR>
            <TR><TD>qScale = pow(500, 1 - 0.6)</TD></TR>
            <TR><TD><FONT COLOR="#7c3aed">即 <B>pow(500, 0.4)</B></FONT></TD></TR>
            <TR><TD>暴涨复杂度被指数(0.4)无情压缩</TD></TR>
        </TABLE>
    >];

    Result [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#10b981" BGCOLOR="#ecfdf5" STYLE="ROUNDED">
            <TR><TD><FONT COLOR="#047857"><B>最终 QP 分配</B></FONT></TD></TR>
            <TR><TD>QP 仅发生温和调整</TD></TR>
            <TR><TD><B>完美避免码流瞬间崩塌！</B></TD></TR>
        </TABLE>
    >];

    History -> EMA [label=" 长期记忆"];
    T0 -> EMA [label=" 突发噪声", color="#ef4444", fontcolor="#ef4444", style="bold"];
    EMA -> qCompress [label=" 传入 500\n(未折叠)"];
    qCompress -> Result [label=" 传入温和因子\n(已折叠)"];
}

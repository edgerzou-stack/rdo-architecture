digraph G {
    rankdir=LR;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=14, penwidth=1.5];
    edge [color="#64748b", arrowsize=0.8, fontname="Helvetica", fontsize=12, penwidth=1.2];

    History [label="历史低复杂度积累\n(T-3 ~ T-1 连续静止)", color="#64748b", fillcolor="#f8fafc", fontcolor="#334155"];
    T0 [label="当前瞬间爆炸帧\n(T0: 复杂度暴涨 10 倍)", color="#ef4444", fillcolor="#fef2f2", fontcolor="#b91c1c"];
    
    EMA [label="Step 1: EMA 低通滤波\n(拖影平滑)", color="#0ea5e9", fillcolor="#f0f9ff", fontcolor="#0284c7"];
    qCompress [label="Step 2: qCompress\n(非线性空间折叠)", color="#8b5cf6", fillcolor="#f5f3ff", fontcolor="#6d28d9"];
    Result [label="最终 QP 分配\n(温和调整，避免崩溃)", color="#10b981", fillcolor="#ecfdf5", fontcolor="#047857"];

    {rank=same; History; T0;}

    History -> EMA [label=" 长期记忆"];
    T0 -> EMA [label=" 突发噪声", color="#ef4444", fontcolor="#ef4444", style="bold"];
    EMA -> qCompress [label=" 滤后平滑复杂度"];
    qCompress -> Result [label=" 折叠后目标系数"];
}
